{
  "name": "clayhandlebars",
  "version": "6.0.0",
  "description": "A collection of helpers and partials for handlebars",
  "main": "index.js",
  "browser": "dist/browser.js",
  "files": [
    "dist",
    "helpers",
    "lib",
    "partials",
    "index.js",
    "!**/*.test.js"
  ],
  "scripts": {
    "lint": "eslint",
    "test-local": "node --test \"helpers/**/*.test.js\" \"lib/*.test.js\" \"partials/*.test.js\" \"test/*.test.js\"",
    "test": "npm run lint && node --test --experimental-test-coverage --test-coverage-exclude=\"**/*.test.js\" --test-coverage-exclude=\"test/**\" --test-coverage-lines=95 \"helpers/**/*.test.js\" \"lib/*.test.js\" \"partials/*.test.js\" \"test/*.test.js\"",
    "generate-readme": "node docs/generate-readme.js",
    "check-readme": "node docs/generate-readme.js --check",
    "build": "vite build",
    "watch": "vite build --watch",
    "check-build": "node scripts/check-browser-bundle.js",
    "prepack": "vite build",
    "release": "./scripts/release.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clay/handlebars.git"
  },
  "keywords": [
    "handlebars"
  ],
  "author": "New York Media",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/clay/handlebars/issues"
  },
  "homepage": "https://github.com/clay/handlebars#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "vite": "8.3.5"
  },
  "dependencies": {
    "clay-log": "^1.6.0",
    "handlebars": "^4.7.10",
    "he": "^1.2.0",
    "js-yaml": "^5.5.0",
    "lodash": "^4.18.1",
    "speakingurl": "^14.0.1",
    "striptags": "^3.2.0"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=26.12.1"
  }
}
